-  /// Detiene la generación en curso conservando lo ya recibido.
-  void stopGeneration() {
-    if (!_isLoading) return;
-    _stopRequested = true;
-    _streamSubscription?.cancel();
-    _streamSubscription = null;
-    final done = _streamCompleter;
-    if (done != null && !done.isCompleted) {
-      done.complete();
-    }
-    notifyListeners();
-  }
