+              errorBuilder: (_, __, ___) => _buildPlaceholder(context),
+            )
+          : image.localPath != null && image.localPath!.isNotEmpty
+              ? Image.file(
+                  File(image.localPath!),
+                  width: width,
+                  height: height,
+                  fit: BoxFit.cover,
+                  cacheWidth: 800,
+                  errorBuilder: (_, __, ___) => _buildPlaceholder(context),
+                )
+              : _buildPlaceholder(context),
+    );
+  }
+
+  /// Visor a pantalla completa para las imágenes del mensaje.
+  Future<void> _showImageViewer(
+    BuildContext context,
+    MessageImage image,
+  ) async {
+    Widget imageWidget;
+    if (image.base64Data != null && image.base64Data!.isNotEmpty) {
+      imageWidget = Image.memory(
+        base64Decode(image.base64Data!),
+        fit: BoxFit.contain,
+      );
+    } else if (image.localPath != null && image.localPath!.isNotEmpty) {
+      imageWidget = Image.file(
+        File(image.localPath!),
+        fit: BoxFit.contain,
+      );
+    } else {
+      return;
+    }
+
+    await showDialog<void>(
+      context: context,
+      barrierColor: Colors.black87,
+      builder: (context) => Dialog(
+        insetPadding: const EdgeInsets.all(24),
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            Row(
+              mainAxisAlignment: MainAxisAlignment.end,
+              children: [
+                IconButton(
+                  tooltip: 'Cerrar',
+                  onPressed: () => Navigator.of(context).pop(),
+                  icon: const Icon(Icons.close),
+                ),
+              ],
+            ),
+            Flexible(
+              child: InteractiveViewer(
+                minScale: 0.8,
+                maxScale: 5,
+                child: imageWidget,
+              ),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Widget _buildPlaceholder(BuildContext context) {
+    return Container(
+      color: Theme.of(context).colorScheme.surfaceContainerHighest,
+      child: Center(
+        child: Icon(
+          Icons.image,
+          size: 40,
+          color: Theme.of(context)
+              .colorScheme
+              .onSurfaceVariant
+              .withValues(alpha: 0.5),
+        ),
+      ),
+    );
+  }
+
+  Widget _buildFooter(BuildContext context) {
+    final colorScheme = Theme.of(context).colorScheme;
+    final footerColor = message.isUser
+        ? colorScheme.onPrimaryContainer.withValues(alpha: 0.8)
+        : colorScheme.onSurfaceVariant;
+
+    return Wrap(
+      alignment: WrapAlignment.end,
+      crossAxisAlignment: WrapCrossAlignment.center,
+      spacing: 8,
+      runSpacing: 2,
+      children: [
+        if (!message.isUser && message.model != null)
+          Container(
+            padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
+            decoration: BoxDecoration(
+              color: colorScheme.primaryContainer.withValues(alpha: 0.5),
+              borderRadius: BorderRadius.circular(8),
+            ),
+            child: Text(
+              message.model!,
+              style: TextStyle(
+                fontSize: 12,
+                color: colorScheme.onPrimaryContainer,
+                fontWeight: FontWeight.w500,
+              ),
+            ),
+          ),
+        Text(
+          _formatTime(message.timestamp),
+          style: TextStyle(fontSize: 12, color: footerColor),
+        ),
+        if (message.isError)
+          Icon(
+            Icons.error_outline,
+            size: 14,
+            color: colorScheme.error,
+          ),
+        if (!message.isUser && message.metadata?['finishReason'] != null)
+          Text(
+              switch (message.metadata!['finishReason']) {
+                'completed' => 'Completada',
+                'length' => 'Límite de respuesta alcanzado',
+                'stopped' => 'Detenida',
+                'interrupted' => 'Interrumpida',
+                _ => 'Finalizada',
+              },
+              style: TextStyle(fontSize: 12, color: footerColor)),
+        if (onContinue != null)
+          TextButton.icon(
+              onPressed: onContinue,
+              icon: const Icon(Icons.play_arrow, size: 16),
+              label: const Text('Continuar')),
+        if (onCopy != null || onExport != null)
+          PopupMenuButton<String>(
+            tooltip: 'Acciones del mensaje',
+            icon: const Icon(Icons.more_horiz, size: 18),
+            onSelected: (action) {
+              if (action == 'copy') {
+                onCopy?.call();
+              }
+              if (action == 'export') {
+                onExport?.call();
+              }
+            },
+            itemBuilder: (_) => [
+              if (onCopy != null)
+                const PopupMenuItem(value: 'copy', child: Text('Copiar')),
+              if (onExport != null)
+                const PopupMenuItem(
+                    value: 'export', child: Text('Exportar respuesta')),
+            ],
+          ),
+        if (!message.isUser && onRegenerate != null)
+          TextButton.icon(
+            onPressed: onRegenerate,
+            icon: const Icon(Icons.refresh, size: 14),
+            label: const Text('Regenerar'),
+            style: TextButton.styleFrom(
+              foregroundColor: colorScheme.primary,
+              minimumSize: const Size(0, 28),
+              padding: const EdgeInsets.symmetric(horizontal: 6),
+              tapTargetSize: MaterialTapTargetSize.shrinkWrap,
+              textStyle: const TextStyle(fontSize: 12),
+            ),
+          ),
+        if (message.isUser && onEdit != null)
+          IconButton(
+            tooltip: 'Editar y reenviar',
+            onPressed: onEdit,
+            icon: const Icon(Icons.edit_outlined, size: 14),
+            color: footerColor,
+            padding: const EdgeInsets.all(2),
+            constraints: const BoxConstraints(),
+            visualDensity: VisualDensity.compact,
+          ),
+      ],
+    );
+  }
+
+  Widget _buildAssistantAvatar(BuildContext context) {
+    final colorScheme = Theme.of(context).colorScheme;
+    return Container(
+      width: 36,
+      height: 36,
+      decoration: BoxDecoration(
+        color: colorScheme.primaryContainer,
+        shape: BoxShape.circle,
+        border: Border.all(
+          color: colorScheme.primary.withValues(alpha: 0.3),
+          width: 1,
+        ),
+      ),
+      child: Icon(
+        Icons.auto_awesome,
+        size: 20,
+        color: colorScheme.onPrimaryContainer,
+      ),
+    );
+  }
+
+  String _formatTime(DateTime timestamp) {
+    final hour = timestamp.hour.toString().padLeft(2, '0');
+    final minute = timestamp.minute.toString().padLeft(2, '0');
+    return '$hour:$minute';
+  }
+}
+
+class _ActionChip extends StatelessWidget {
+  final IconData icon;
+  final String label;
+  final VoidCallback onTap;
