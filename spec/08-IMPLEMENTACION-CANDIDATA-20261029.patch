+/// Estado del servidor Ollama
+enum OllamaStatus {
+  notInstalled,
+  installing,
+  installed,
+  starting,
+  running,
+  stopping,
+  error,
+}
+
+/// Información del modelo Ollama
+class OllamaModel {
+  final String name;
+  final String? digest;
+  final int? size;
+  final DateTime? modifiedAt;
+  final String? details;
+
+  OllamaModel({
+    required this.name,
+    this.digest,
+    this.size,
+    this.modifiedAt,
+    this.details,
+  });
+
+  factory OllamaModel.fromJson(Map<String, dynamic> json) {
+    return OllamaModel(
+      name: json['name'] ?? json['model'] ?? '',
+      digest: json['digest'],
+      size: json['size'],
+      modifiedAt: json['modified_at'] != null
+          ? DateTime.tryParse(json['modified_at'])
+          : null,
+      details: json['details'] != null ? jsonEncode(json['details']) : null,
+    );
+  }
+
+  /// Formatear tamaño a legible
+  String get sizeFormatted {
+    if (size == null) return 'Unknown';
+    final bytes = size!;
+    if (bytes < 1024 * 1024) return '${(bytes / 1024).toStringAsFixed(1)} KB';
+    if (bytes < 1024 * 1024 * 1024) {
+      return '${(bytes / (1024 * 1024)).toStringAsFixed(1)} MB';
+    }
+    return '${(bytes / (1024 * 1024 * 1024)).toStringAsFixed(1)} GB';
+  }
+
+  /// Nombre corto (sin tag)
+  String get shortName => name.split(':').first;
+
+  /// Tag del modelo
+  String get tag {
+    final parts = name.split(':');
+    return parts.length > 1 ? parts[1] : 'latest';
+  }
+}
+
+/// Información del servidor Ollama
+class OllamaServerInfo {
+  final OllamaStatus status;
+  final String? version;
+  final String? errorMessage;
+  final int port;
+
+  const OllamaServerInfo({
+    required this.status,
+    this.version,
+    this.errorMessage,
+    this.port = 11434,
+  });
+
+  OllamaServerInfo copyWith({
+    OllamaStatus? status,
+    String? version,
+    String? errorMessage,
+    int? port,
+  }) {
+    return OllamaServerInfo(
+      status: status ?? this.status,
+      version: version ?? this.version,
+      errorMessage: errorMessage ?? this.errorMessage,
+      port: port ?? this.port,
+    );
+  }
+}
