-    var remaining = total;
-    var pending = [
-      for (var index = 0; index < needs.length; index++)
-        if (needs[index] > 0) index,
-    ];
-
-    while (remaining > 0 && pending.isNotEmpty) {
-      final share = remaining ~/ pending.length;
-      if (share <= 0) {
-        break;
-      }
