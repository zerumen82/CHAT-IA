+        'no calcules sumas ni recuentos globales si la cobertura es parcial.';
+  }
+
+  String _imageMimeType(String path) {
+    final extension = path.split('.').last.toLowerCase();
+    return switch (extension) {
+      'png' => 'image/png',
+      'webp' => 'image/webp',
+      'gif' => 'image/gif',
+      'bmp' => 'image/bmp',
+      _ => 'image/jpeg',
+    };
+  }
+
+  void selectModel(String model) {
