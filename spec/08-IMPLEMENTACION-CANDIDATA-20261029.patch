+  OllamaMessage({
+    required this.role,
+    required this.content,
+    this.images,
+  });
+
+  Map<String, dynamic> toJson() {
+    final map = <String, dynamic>{
+      'role': role,
+      'content': content,
+    };
+    if (images != null && images!.isNotEmpty) {
+      map['images'] = images!.map((i) => i.base64Data).toList();
+    }
+    return map;
